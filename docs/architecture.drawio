<mxfile host="drawio">
  <diagram id="arch" name="Experiment setup">
    <mxGraphModel dx="1560" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Source, spans all lanes (y 40 to 465) -->
        <mxCell id="src" value="&lt;b&gt;Synthetic data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;generated by Claude Opus 5.5 on Amazon Bedrock&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="290" height="425" as="geometry" />
        </mxCell>

        <!-- Lane titles. Lanes are 150 apart; every box is 100 tall -->
        <mxCell id="t1" value="Fraud triage" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="390" y="40" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Model routing" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="390" y="190" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Refund policy" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="390" y="340" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Lane 1: fraud -->
        <mxCell id="f_data" value="&lt;b&gt;100 card transactions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5 classes:&lt;br&gt;legitimate · card_testing · account_takeover · friendly_fraud · merchant_collusion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="65" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f_jev" value="&lt;b&gt;Jev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Choice + 2 Nouls + Score, one request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="730" y="65" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- Lane 2: routing -->
        <mxCell id="r_data" value="&lt;b&gt;80 prompts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4 tiers: simple · medium · complex · reasoning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="215" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r_jev" value="&lt;b&gt;Jev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Choice: which tier&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="730" y="215" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r_claude" value="&lt;b&gt;Claude on Bedrock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;simple → Haiku 4.5&lt;br&gt;medium → Sonnet 5&lt;br&gt;complex → Opus 5.5&lt;br&gt;reasoning → Opus 5.5 + thinking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1030" y="215" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r_grader" value="&lt;b&gt;Opus 5.5 grader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vs reference answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1320" y="215" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- Lane 3: refund -->
        <mxCell id="d_data" value="&lt;b&gt;60 customer messages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;3 reasons: defective · wrong_item · changed_mind&lt;br&gt;+ seeded delivery/request dates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="365" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_jev" value="&lt;b&gt;Jev, three ways&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one question · days in code · reason only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="730" y="365" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_code" value="&lt;b&gt;Code applies the window&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;defective, wrong_item: 30 days&lt;br&gt;changed_mind: 14 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1030" y="365" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Source to each lane: exit at the lane's centre line (y = 115, 265, 415) -->
        <mxCell id="e_s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0;exitDx=0;exitDy=75;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="src" target="f_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0;exitDx=0;exitDy=225;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="src" target="r_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0;exitDx=0;exitDy=375;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="src" target="d_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Within lanes -->
        <mxCell id="e_f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="f_data" target="f_jev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r_data" target="r_jev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r_jev" target="r_claude">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r_claude" target="r_grader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="d_data" target="d_jev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="d_jev" target="d_code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
